{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel4dgs.local/schemas/tensor_cache.v1.json",
  "title": "Pixel4DGS tensor cache v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_manifest_sha256",
    "camera_ids",
    "frame_ids",
    "arrays"
  ],
  "properties": {
    "schema_version": {"const": "p2g.tensor_cache.v1"},
    "observation_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "camera_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "frame_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "arrays": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rgb", "intrinsic", "world_to_camera", "timestamp_seconds"],
      "properties": {
        "rgb": {"$ref": "#/$defs/array"},
        "intrinsic": {"$ref": "#/$defs/array"},
        "world_to_camera": {"$ref": "#/$defs/array"},
        "timestamp_seconds": {"$ref": "#/$defs/array"}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "array": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "dtype", "shape", "order"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "dtype": {"enum": ["uint8", "float32", "float64"]},
        "shape": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "integer", "minimum": 1}
        },
        "order": {"const": "C"}
      }
    }
  }
}
